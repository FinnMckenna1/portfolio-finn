---
import Snoops from "../assets/farm/farm-logo.-Sticker.png";
import HerVid from "../assets/her-vi1.mp4";
import "../assets/her-im1.jpg";
import wallpaper from "../assets/farm/wallpaper.avif";
import tshirt from "../assets/cafe/cafe-T-shirt-mockup.png";
import CAFELOGO from "../assets/cafe/CAFE-LOGO-WHITE.png";
import SatayL from "../assets/satay/SATAY_SATAY-Logo.png";
import sataybg from "../assets/satay/cooking-image.jpeg";
import noodlebg from "../assets/website/cooking-bg.jpeg";
import text from "../assets/services/text.jpeg";
import inspectWork from "../assets/services/service-step1.mp4";
import contactMe from "../assets/services/service-step2.mp4";
import getStarted from "../assets/services/service-step3.mp4";
import revisionsFiles from "../assets/services/service-step4.mp4";
import followUp from "../assets/services/service-step5.mp4";
import redgumBgTile from "../assets/redgum/redgum-mainTileBg.jpg";
---

<body>
  <main>
    <section class="hero">
      <div class="wrap">
        <video
          class="hero__video"
          autoplay
          muted
          loop
          playsinline
          poster="her-im1.jpg"
        >
          <source src={HerVid} type="video/mp4" />
        </video>
        <div class="meta reveal">
          <span class="eyebrow">Multidisciplinary Designer</span>
          <span class="eyebrow" id="loc"
            >Perth, AU &nbsp;/&nbsp; Available Q4 2026</span
          >
        </div>
        <h1 class="reveal">
          Design across<br />product, brand<br />&amp; <em>the web.</em>
        </h1>
        <p class="sub reveal">
          I'm Finn, a multidisciplinary designer working at the intersection of
          product, identity, and interaction. I help teams turn fuzzy ideas into
          clear, considered, ship-ready design.
        </p>
        <div class="cta-row reveal">
          <a class="btn primary" href="#work">View selected work →</a>
          <a class="btn ghost" href="#contact">Get in touch</a>
        </div>
      </div>
    </section>
  </main>
  <!-- ============ PROGRAMS (infinite marquee) ============ -->
  <section id="programs">
    <div class="wrap">
      <div class="sec-head">
        <span class="idx">✳</span>
        <h2>My favourite programs</h2>
      </div>
    </div>
    <div class="marquee">
      <div class="marquee-track">
        <!-- ===== list (copy 1) ===== -->
        <div class="prog">
          <span class="ico" style="background:#001E36"
            ><b style="color:#31A8FF">Ps</b></span
          ><span class="name">Photoshop</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#330000"
            ><b style="color:#FF9A00">Ai</b></span
          ><span class="name">Illustrator</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#49021F"
            ><b style="color:#FF3366">Id</b></span
          ><span class="name">InDesign</span>
        </div>
        <div class="prog">
          <span
            class="ico"
            style="background:#fff;box-shadow:inset 0 0 0 1px rgba(0,0,0,.08)"
            ><svg width="17" height="26" viewBox="0 0 38 57" aria-hidden="true"
              ><path
                d="M19 28.5a9.5 9.5 0 1 1 19 0 9.5 9.5 0 0 1-19 0z"
                fill="#1ABCFE"></path><path
                d="M0 47.5A9.5 9.5 0 0 1 9.5 38H19v9.5a9.5 9.5 0 1 1-19 0z"
                fill="#0ACF83"></path><path
                d="M19 0v19h9.5a9.5 9.5 0 1 0 0-19H19z"
                fill="#FF7262"></path><path
                d="M0 9.5A9.5 9.5 0 0 0 9.5 19H19V0H9.5A9.5 9.5 0 0 0 0 9.5z"
                fill="#F24E1E"></path><path
                d="M0 28.5A9.5 9.5 0 0 0 9.5 38H19V19H9.5A9.5 9.5 0 0 0 0 28.5z"
                fill="#A259FF"></path></svg
            ></span
          ><span class="name">Figma</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#146EF5"
            ><b style="color:#fff">W</b></span
          ><span class="name">Webflow</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#000000"
            ><b style="color:#fff">F</b></span
          ><span class="name">Framer</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#0A0A0A"
            ><svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="#fff"
              aria-hidden="true"
              ><path d="M5 2.5l13 6.2-5.4 1.7-1.6 5.6z"></path></svg
            ></span
          ><span class="name">Cursor</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#17191E"
            ><b
              style="background:linear-gradient(180deg,#fff,#B96BFF);-webkit-background-clip:text;background-clip:text;color:transparent;font-weight:700;font-size:19px"
              >A</b
            ></span
          ><span class="name">Astro</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#00aeff"
            ><b style="color:#ffffff;font-size:22px">~</b></span
          ><span class="name">Tilda</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#ff0000"
            ><b style="color:#fff">Fi</b></span
          ><span class="name">Firefly</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#00005B"
            ><b style="color:#9999FF">Ae</b></span
          ><span class="name">After Effects</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#2A0634"
            ><b style="color:#EA77FF">Pr</b></span
          ><span class="name">Premiere Pro</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#001E36"
            ><b style="color:#31A8FF">Lr</b></span
          ><span class="name">Lightroom</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#2A1400"
            ><b style="color:#F2A65E">Br</b></span
          ><span class="name">Bridge</span>
        </div>

        <!-- ===== list (copy 2 — identical, for the seamless loop) ===== -->
        <div class="prog">
          <span class="ico" style="background:#001E36"
            ><b style="color:#31A8FF">Ps</b></span
          ><span class="name">Photoshop</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#330000"
            ><b style="color:#FF9A00">Ai</b></span
          ><span class="name">Illustrator</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#49021F"
            ><b style="color:#FF3366">Id</b></span
          ><span class="name">InDesign</span>
        </div>
        <div class="prog">
          <span
            class="ico"
            style="background:#fff;box-shadow:inset 0 0 0 1px rgba(0,0,0,.08)"
            ><svg width="17" height="26" viewBox="0 0 38 57" aria-hidden="true"
              ><path
                d="M19 28.5a9.5 9.5 0 1 1 19 0 9.5 9.5 0 0 1-19 0z"
                fill="#1ABCFE"></path><path
                d="M0 47.5A9.5 9.5 0 0 1 9.5 38H19v9.5a9.5 9.5 0 1 1-19 0z"
                fill="#0ACF83"></path><path
                d="M19 0v19h9.5a9.5 9.5 0 1 0 0-19H19z"
                fill="#FF7262"></path><path
                d="M0 9.5A9.5 9.5 0 0 0 9.5 19H19V0H9.5A9.5 9.5 0 0 0 0 9.5z"
                fill="#F24E1E"></path><path
                d="M0 28.5A9.5 9.5 0 0 0 9.5 38H19V19H9.5A9.5 9.5 0 0 0 0 28.5z"
                fill="#A259FF"></path></svg
            ></span
          ><span class="name">Figma</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#146EF5"
            ><b style="color:#fff">W</b></span
          ><span class="name">Webflow</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#000000"
            ><b style="color:#fff">F</b></span
          ><span class="name">Framer</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#0A0A0A"
            ><svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="#fff"
              aria-hidden="true"
              ><path d="M5 2.5l13 6.2-5.4 1.7-1.6 5.6z"></path></svg
            ></span
          ><span class="name">Cursor</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#17191E"
            ><b
              style="background:linear-gradient(180deg,#fff,#B96BFF);-webkit-background-clip:text;background-clip:text;color:transparent;font-weight:700;font-size:19px"
              >A</b
            ></span
          ><span class="name">Astro</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#00aeff"
            ><b style="color:#ffffff;font-size:22px">~</b></span
          ><span class="name">Tilda</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#ff0000"
            ><b style="color:#fff">Fi</b></span
          ><span class="name">Firefly</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#00005B"
            ><b style="color:#9999FF">Ae</b></span
          ><span class="name">After Effects</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#2A0634"
            ><b style="color:#EA77FF">Pr</b></span
          ><span class="name">Premiere Pro</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#001E36"
            ><b style="color:#31A8FF">Lr</b></span
          ><span class="name">Lightroom</span>
        </div>
        <div class="prog">
          <span class="ico" style="background:#2A1400"
            ><b style="color:#F2A65E">Br</b></span
          ><span class="name">Bridge</span>
        </div>
      </div>
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="idx">01</span>
        <h2>Selected work</h2>
      </div>
      <div class="work-grid reveal">
        <a
          class="project"
          href="/work#coffee-burger"
          style={{ "--project-bg": `url("${tshirt.src}")` }}
        >
          <div class="project__top">
            <span class="tag">Brand · Redesign</span>
          </div>

          <div class="project-bg">
            <img src={CAFELOGO.src} alt="" />
          </div>

          <span class="arrow">Read case study →</span>
        </a>
        <a
          href="/work#scoops"
          class="project"
          href="../work"
          style={`--project-bg: url("${wallpaper.src}")`}
        >
          <div class="project__top">
            <span class="tag">Brand · Redesign</span>
          </div>

          <div class="project-bg">
            <img src={Snoops.src} alt="" />
          </div>

          <span class="arrow">Read case study →</span>
        </a>

        <a
          href="/work#noodle-bar"
          class="project project-cover"
          style={`--project-bg: url("${sataybg.src}")`}
        >
          <div class="project__top">
            <span class="tag">Brand · Redesign</span>
          </div>

          <div class="project-bg">
            <div class="project-bg work-text">NoodleBar</div>
          </div>

          <span class="arrow">Read case study →</span>
        </a>

        <a
          href="/work#redgum"
          class="project project-cover"
          href="../work"
          style={`--project-bg: url("${redgumBgTile.src}")`}
        >
          <div class="project__top">
            <span class="tag">Product · Web</span>
          </div>

          <div class="project-bg work-text">Redgum</div>

          <span class="arrow">Read case study →</span>
        </a>
      </div>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="idx">02</span>
        <h2>About</h2>
      </div>
      <div class="about-grid reveal">
        <div>
          <p>
            I move fluidly between product, brand, and web because I think good
            design rarely stays in one lane. A product needs a voice; a brand
            needs to work in an interface; a website needs both.
          </p>
          <p>
            My work tends to be systems-minded and detail-obsessed — I like
            building things that scale, hold together, and still feel human.
            I've partnered with startups and established teams, usually
            somewhere between strategy and pixels.
          </p>
          <p>
            Outside of client work, I prototype, write, and tinker with the
            tools designers use to build.
          </p>
        </div>
        <div class="facts">
          <div class="row">
            <span class="k">Based in</span><span class="v"
              >Perth, Australia</span
            >
          </div>
          <div class="row">
            <span class="k">Focus</span><span class="v"
              >Product · Brand · Web</span
            >
          </div>
          <div class="row">
            <span class="k">Tools</span><span class="v"
              >Print · Code · Motion</span
            >
          </div>
          <div class="row">
            <span class="k">Experience</span><span class="v">8+ years</span>
          </div>
          <div class="row">
            <span class="k">Status</span><span class="v">Open to projects</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section id="howto">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="idx">05</span>
        <h2>How it works</h2>
      </div>
      <div class="howto-row reveal">
        <div class="howto-card">
          <div class="howto-vid">
            <video src={inspectWork} muted loop playsinline preload="metadata"
            ></video>
          </div>

          <span class="howto-step">Step 01</span>
          <h3>Inspect my work</h3>
          <p>
            Browse my selected projects to see if the style and range fit what
            you need.
          </p>
        </div>

        <div class="howto-card">
          <div class="howto-vid">
            <video src={contactMe} muted loop playsinline preload="metadata"
            ></video>
          </div>

          <span class="howto-step">Step 02</span>
          <h3>Contact me</h3>
          <p>
            Send a short note about your project, timeline, and budget. I reply
            within a day.
          </p>
        </div>

        <div class="howto-card">
          <div class="howto-vid">
            <video src={getStarted} muted loop playsinline preload="metadata"
            ></video>
          </div>

          <span class="howto-step">Step 03</span>
          <h3>Let's get started</h3>
          <p>
            We confirm scope and kick off, and I turn the brief into first
            directions.
          </p>
        </div>

        <div class="howto-card">
          <div class="howto-vid">
            <video
              src={revisionsFiles}
              muted
              loop
              playsinline
              preload="metadata"></video>
          </div>

          <span class="howto-step">Step 04</span>
          <h3>Revisions + packed files</h3>
          <p>
            We refine together, then I hand over polished, production-ready
            packed files.
          </p>
        </div>

        <div class="howto-card">
          <div class="howto-vid">
            <video src={followUp} muted loop playsinline preload="metadata"
            ></video>
          </div>

          <span class="howto-step">Step 05</span>
          <h3>Follow up</h3>
          <p>
            I check in after delivery to make sure everything works and you're
            happy.
          </p>
        </div>
      </div>
    </div>
  </section>
</body>
